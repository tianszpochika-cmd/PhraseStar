+const REPORT_SHARE_KEY = /^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$/
+
+function reportShareIdempotencyKey(share: { idempotencyKey?: string | null } | undefined, prefix: string): string {
+  if (share == null || !Object.prototype.hasOwnProperty.call(share, 'idempotencyKey')) return createClientId(prefix)
+  const provided = share.idempotencyKey
+  if (typeof provided !== 'string' || !REPORT_SHARE_KEY.test(provided)) {
+    throw new ApiError('Idempotency-Key must contain 16-128 safe characters', 400, { code: 'IDEMPOTENCY_KEY_INVALID' })
+  }
+  return provided
+}
+
+function shareWriteStatus(error: unknown): number | undefined {
+  if (error instanceof ApiError) return error.status
+  if (error && typeof error === 'object' && 'status' in error && typeof (error as { status: unknown }).status === 'number') {
+    return (error as { status: number }).status
+  }
+  return undefined
+}
+
+function isTransientShareWriteError(error: unknown): boolean {
+  const status = shareWriteStatus(error)
+  return status === 0 || status === 503 || status === 504
+}
+
+async function withShareWriteRetry<T>(send: () => Promise<T>): Promise<T> {
+  try {
+    return await send()
+  } catch (error) {
+    if (!isTransientShareWriteError(error)) throw error
+    return await send()
+  }
+}
