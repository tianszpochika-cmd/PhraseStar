+  const api = loadIssueApi()
+  const key = 'mb016-report-share-1234567890abcdef'
+  let failures = 1
+  api.setRespond(async () => {
+    if (failures > 0) {
+      failures -= 1
+      throw Object.assign(new Error('unavailable'), { status: 503 })
+    }
+    return { ref: 'a'.repeat(32), publicPath: `/api/v1/public/learning/report-shares/${'a'.repeat(32)}` }
+  })
+  await api.api.issueReportShare('daily', { idempotencyKey: key, date: '2026-10-12' })
+  assert.equal(api.requests.length, 2)
+  assert.equal(headerKey(api.requests[0]), key)
+  assert.equal(headerKey(api.requests[1]), key)
+  assert.equal(api.requests[0].path, api.requests[1].path)
+
+  api.setRespond(async () => { throw Object.assign(new Error('unavailable'), { status: 503 }) })
+  const beforeFail = api.requests.length
+  await assert.rejects(
+    () => api.api.issueReportShare('daily', { idempotencyKey: key, date: '2026-10-12' }),
+    (error) => error.status === 503 && error.message === 'unavailable',
+  )
+  assert.equal(api.requests.length, beforeFail + 2)
+  assert.equal(headerKey(api.requests[beforeFail]), key)
+  assert.equal(headerKey(api.requests[beforeFail + 1]), key)
+
+  api.setRespond(async () => ({ ref: 'a'.repeat(32), publicPath: `/api/v1/public/learning/report-shares/${'a'.repeat(32)}` }))
+  await api.api.issueReportShare('daily')
+  await api.api.issueReportShare('daily')
+  const generated = api.requests.slice(-2).map(headerKey)
+  assert.match(generated[0], /^mb016-report-share-test-01$/)
+  assert.match(generated[1], /^mb016-report-share-test-02$/)
+  assert.notEqual(generated[0], generated[1])
+
+  const revokeRef = 'b'.repeat(32)
+  await api.api.revokeReportShare(revokeRef)
+  await api.api.revokeReportShare(revokeRef, { idempotencyKey: 'mb016-report-share-revoke1' })
+  const revokeRequests = api.requests.slice(-2)
