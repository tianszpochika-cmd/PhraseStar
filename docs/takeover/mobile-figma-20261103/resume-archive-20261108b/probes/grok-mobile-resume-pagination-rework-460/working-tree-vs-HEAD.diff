+const SHARE_MINT_ROUTE = '/api/v1/learning/reports/{reportType}/shares';
+const SHARE_REVOKE_ROUTE = '/api/v1/learning/report-shares/{ref}/revoke';
+const UPLOAD_URL_ROUTE = '/api/v1/media/assets/{assetId}/upload-url';
+const IDEMPOTENCY_KEY_REQUIRED_REF = '#/components/parameters/IdempotencyKeyRequired';
+
+function hasRequiredIdempotencyKey(operation) {
+  return (operation?.parameters ?? []).some((parameter) => parameter?.$ref === IDEMPOTENCY_KEY_REQUIRED_REF);
+}
+
+test('signed-access remains the sole optional write and durable report shares require Idempotency-Key', () => {
+  const document = canonicalFixture();
+  const mint = document.paths[SHARE_MINT_ROUTE].post;
+  const revoke = document.paths[SHARE_REVOKE_ROUTE].post;
+  const signedAccess = document.paths['/api/v1/content/media/{mediaAssetId}/signed-access'].post;
+  assert.equal(mint.operationId, 'issueLearningReportShare');
+  assert.equal(revoke.operationId, 'revokeLearningReportShare');
+  assert.equal(mint['x-idempotency'].required, true);
+  assert.equal(revoke['x-idempotency'].required, true);
+  assert.equal(mint['x-idempotency'].keyHeader, 'Idempotency-Key');
+  assert.equal(revoke['x-idempotency'].keyHeader, 'Idempotency-Key');
+  assert.equal(hasRequiredIdempotencyKey(mint), true);
+  assert.equal(hasRequiredIdempotencyKey(revoke), true);
+  assert.equal(signedAccess['x-idempotency'].required, false);
+  assert.equal(signedAccess.operationId, 'signContentMediaAccess');
+  const report = validateApiContractData({ openApi: document, schemaRegistry });
+  assert.equal(report.summary.idempotencyExceptionCount, 1);
+  assert.equal(report.errors.some((error) => error.includes('shares')), false);
+  assert.equal(report.errors.some((error) => error.includes('upload-url')), false);
+});
+
+test('the exact fail-closed media upload write does not need x-idempotency', () => {
+  const document = canonicalFixture();
+  const upload = document.paths[UPLOAD_URL_ROUTE].post;
+  assert.equal(upload.operationId, 'mintMediaUploadUrl');
+  assert.equal(Object.hasOwn(upload, 'x-idempotency'), false);
+  assert.equal(upload['x-fail-closed'].mode, 'NO_SUCCESS_PATH');
+  assert.equal(upload['x-fail-closed'].sideEffects, false);
+  const report = validateApiContractData({ openApi: document, schemaRegistry });
+  assert.equal(report.errors.some((error) => error.includes('upload-url')), false);
+});
+
+test('fail-closed upload exemption rejects success, side effects, incomplete predicate and added idempotency', () => {
+  const successErrors = validateChanged((document) => {
+    document.paths[UPLOAD_URL_ROUTE].post.responses['200'] = { description: 'False success' };
+  });
+  assert(successErrors.some((error) => error.includes('POST /api/v1/media/assets/{assetId}/upload-url needs x-idempotency')));
+
+  const sideEffectErrors = validateChanged((document) => {
+    document.paths[UPLOAD_URL_ROUTE].post['x-fail-closed'].sideEffects = true;
+  });
+  assert(sideEffectErrors.some((error) => error.includes('POST /api/v1/media/assets/{assetId}/upload-url needs x-idempotency')));
+
+  const incompleteErrors = validateChanged((document) => {
+    delete document.paths[UPLOAD_URL_ROUTE].post['x-fail-closed'].reason;
+  });
+  assert(incompleteErrors.some((error) => error.includes('POST /api/v1/media/assets/{assetId}/upload-url needs x-idempotency')));
+
+  const declaredErrors = validateChanged((document) => {
+    const operation = document.paths[UPLOAD_URL_ROUTE].post;
+    operation['x-idempotency'] = {
+      required: true,
+      strategy: 'invented-upload-receipt',
+      keyHeader: 'Idempotency-Key',
+      replayBehavior: 'invented',
